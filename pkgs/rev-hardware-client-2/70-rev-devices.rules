# REV Robotics USB devices using SLCan
KERNEL=="ttyACM*", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="a30e", SYMLINK+="spark%n", MODE="0660", GROUP="dialout", TAG+="uaccess"
KERNEL=="ttyACM*", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="a3b0", SYMLINK+="revhub%n", MODE="0660", GROUP="dialout", TAG+="uaccess"

# Devices in Recovery Mode
SUBSYSTEMS=="usb", ATTR{idVendor}=="0483", ATTR{idProduct}=="df11", MODE="0660", GROUP="plugdev", TAG+="uaccess"
